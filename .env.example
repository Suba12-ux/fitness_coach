# Окружение приложения
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (для docker compose)
POSTGRES_USER=sensei
POSTGRES_PASSWORD=sensei
POSTGRES_DB=fitness_coach
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000

# Frontend (docker compose) — отдельный порт только для веб-интерфейса
FRONTEND_PORT=8080

# Домены фронтенда, которым разрешены CORS-запросы (через запятую)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Строки подключения (для локального запуска без Docker)
DATABASE_URL=postgresql+asyncpg://sensei:sensei@localhost:5432/fitness_coach
REDIS_URL=redis://localhost:6379/0

# LLM
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Выполнение агентов и Worker
SENSEI_MAX_RETRIES=3
SENSEI_AGENT_TIMEOUT_SECONDS=10
WORKER_JOB_TIMEOUT_SECONDS=300
WORKER_MAX_TRIES=3

# Аутентификация: серверные сессии в HttpOnly cookie
AUTH_COOKIE_NAME=sensei_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=7
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
